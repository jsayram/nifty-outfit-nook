// Settings for the NiftyOutfitNook app target.

PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = com.jsayram.niftyoutfitnook
#include "Version.xcconfig"

// UI code defaults to the main actor. Background work is explicit.
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor

// The entitlements file follows NOOK_WEATHERKIT (Phase 29) and NOOK_ICLOUD (Phase 21b), both in
// Base.xcconfig: WeatherKit's and iCloud's entitlements only when their switch is YES. Any other
// value picks no file and fails the build, not the app. Debug builds use a copy that adds
// get-task-allow (Phase 30a): StoreKit's local testing on the simulator refuses an app without it
// ("not installed for development"). Release never has it. The names read WEATHERKIT_ICLOUD_CONFIG.
NOOK_ENTITLEMENTS_FILE_NO_NO_Release = NiftyOutfitNook/NiftyOutfitNook.entitlements
NOOK_ENTITLEMENTS_FILE_YES_NO_Release = Configs/NiftyOutfit-WeatherKit.entitlements
NOOK_ENTITLEMENTS_FILE_NO_YES_Release = Configs/NiftyOutfit-ICloud.entitlements
NOOK_ENTITLEMENTS_FILE_YES_YES_Release = Configs/NiftyOutfit-WeatherKit-ICloud.entitlements
NOOK_ENTITLEMENTS_FILE_NO_NO_Debug = Configs/NiftyOutfitNook-Debug.entitlements
NOOK_ENTITLEMENTS_FILE_YES_NO_Debug = Configs/NiftyOutfit-WeatherKit-Debug.entitlements
NOOK_ENTITLEMENTS_FILE_NO_YES_Debug = Configs/NiftyOutfit-ICloud-Debug.entitlements
NOOK_ENTITLEMENTS_FILE_YES_YES_Debug = Configs/NiftyOutfit-WeatherKit-ICloud-Debug.entitlements
CODE_SIGN_ENTITLEMENTS = $(NOOK_ENTITLEMENTS_FILE_$(NOOK_WEATHERKIT)_$(NOOK_ICLOUD)_$(CONFIGURATION))
// iCloud sync (Phase 21b): CKSyncEngine needs the remote-notification background mode for its
// silent pushes. There's no build setting for UIBackgroundModes, so Configs/AppInfo.plist is
// preprocessed and includes the key only when NOOK_ICLOUD = YES.
INFOPLIST_PREPROCESS = YES
INFOPLIST_PREPROCESSOR_DEFINITIONS = NOOK_ICLOUD_$(NOOK_ICLOUD)=1
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ENABLE_PREVIEWS = YES

// Generated Info.plist. No NSAppTransportSecurity keys: ATS stays fully on.
GENERATE_INFOPLIST_FILE = YES
// The launch screen's colour, the one key the build settings can't set (see the file).
INFOPLIST_FILE = Configs/AppInfo.plist
INFOPLIST_KEY_CFBundleDisplayName = Outfit Nook
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.lifestyle
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
// Phase 22a: the camera, for garment photos (closet/compliance/PERMISSIONS.md). Picking from
// Photos uses the system picker and needs no key. English is the only language, so there's no
// InfoPlist.xcstrings yet; add one, with this string, with the first translation.
INFOPLIST_KEY_NSCameraUsageDescription = Take photos of your clothes to add them to your closet, and take your try-on photo if you set one up.
// Phase 29, live weather (closet/compliance/PERMISSIONS.md). Approximate location while the app is
// open, for the weather only, and only if she turns on "Use my location". A city she types needs no
// permission. NSLocationDefaultAccuracyReduced is in Configs/AppInfo.plist (no build setting for it).
INFOPLIST_KEY_NSLocationWhenInUseUsageDescription = Your rough location gets the forecast, so outfit ideas suit the weather. It's used only for the forecast and isn't saved.
