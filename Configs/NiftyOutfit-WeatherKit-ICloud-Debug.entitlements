<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.developer.default-data-protection</key>
	<string>NSFileProtectionComplete</string>
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>development</string>
	<!-- Phase 29: only used when NOOK_WEATHERKIT = YES (Configs/Base.xcconfig). Needs the WeatherKit
	     capability on the App ID in the Apple Developer portal first. -->
	<key>com.apple.developer.weatherkit</key>
	<true/>
	<!-- Phase 21b: only used when NOOK_ICLOUD = YES (Configs/Base.xcconfig). Needs the iCloud
	     capability with CloudKit and this container on the App ID first, and Push Notifications
	     for CKSyncEngine's wake-ups: docs/icloud.md has Jose's steps. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.jsayram.niftyoutfitnook</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>aps-environment</key>
	<string>development</string>
	<!-- Debug builds only (Configs/App.xcconfig, Phase 30a): get-task-allow marks the app as a
	     development build, which StoreKit's local testing (the .storekit file and SKTestSession)
	     requires on the simulator. Release builds use the file without it. -->
	<key>get-task-allow</key>
	<true/>
</dict>
</plist>
