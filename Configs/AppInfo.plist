<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The launch screen is the room's wall colour, light or dark, so the first frame doesn't
	     flash white or black before the app draws (Phase 18). LaunchBackground in the app's
	     asset catalog holds the DesignSystem background token's values. Every other key but the
	     backup type below is generated from Configs/App.xcconfig. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- The backend and sign-in (Phase 24a), from Configs/Base.xcconfig or Secrets.xcconfig.
	     Empty values keep the app on the fake sign-in and fake backend (GatewaySettings). -->
	<key>NookClerkPublishableKey</key>
	<string>$(CLERK_PUBLISHABLE_KEY)</string>
	<key>NookAPIBaseURL</key>
	<string>$(NOOK_API_BASE_URL)</string>
	<!-- The website's support page (Phase 24d), from NOOK_SUPPORT_URL in Configs/Base.xcconfig. -->
	<key>NookSupportURL</key>
	<string>$(NOOK_SUPPORT_URL)</string>
	<!-- Live weather (Phase 29): location is always approximate, never full accuracy. The switch
	     for WeatherKit comes from NOOK_WEATHERKIT in Configs/Base.xcconfig. -->
	<key>NSLocationDefaultAccuracyReduced</key>
	<true/>
	<key>NookWeatherKitEnabled</key>
	<string>$(NOOK_WEATHERKIT)</string>
	<!-- Picture packs (Phase 30b): StoreKit keeps consumables in the transaction history, so an
	     unfinished pack stays in Transaction.unfinished until the server has credited it. -->
	<key>SKIncludeConsumableInAppPurchaseHistory</key>
	<true/>
	<!-- Backups (Phase 21b): the export file's type, so the Files sheet names it and Restore's
	     picker can ask for it. An encrypted archive; nothing else opens it on iOS. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.jsayram.niftyoutfitnook.backup</string>
			<key>UTTypeDescription</key>
			<string>Nifty Outfit Nook backup</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>nookbackup</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
