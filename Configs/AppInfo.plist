<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The launch screen is the room's wall colour, light or dark, so the first frame doesn't
	     flash white or black before the app draws (Phase 18). LaunchBackground in the app's
	     asset catalog holds the DesignSystem background token's values. Every other key is
	     generated from Configs/App.xcconfig. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
