<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The launch screen is the room wall colour, light or dark, so the first frame does not
	     flash white or black before the app draws (Phase 18). LaunchBackground in the app
	     asset catalog holds the values of the DesignSystem background token. Every other key but the
	     backup type below is generated from Configs/App.xcconfig. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- The backend and its sign-in (Phase 24a, BA4), from Configs/Base.xcconfig or Secrets.xcconfig.
	     Empty keeps the app on the fake backend (GatewaySettings). -->
	<key>NookAPIBaseURL</key>
	<string>$(NOOK_API_BASE_URL)</string>
	<!-- The support page on the website (Phase 24d), from NOOK_SUPPORT_URL in Configs/Base.xcconfig. -->
	<key>NookSupportURL</key>
	<string>$(NOOK_SUPPORT_URL)</string>
	<!-- Live weather (Phase 29): location is always approximate, never full accuracy. The switch
	     for WeatherKit comes from NOOK_WEATHERKIT in Configs/Base.xcconfig. -->
	<key>NSLocationDefaultAccuracyReduced</key>
	<true/>
	<key>NookWeatherKitEnabled</key>
	<string>$(NOOK_WEATHERKIT)</string>
	<!-- Private iCloud sync (Phase 21b): from NOOK_ICLOUD in Configs/Base.xcconfig. -->
	<key>NookICloudEnabled</key>
	<string>$(NOOK_ICLOUD)</string>
#if NOOK_ICLOUD_YES
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
#endif
	<!-- Picture packs (Phase 30b): StoreKit keeps consumables in the transaction history, so an
	     unfinished pack stays in Transaction.unfinished until the server has credited it. -->
	<key>SKIncludeConsumableInAppPurchaseHistory</key>
	<true/>
	<!-- Backups (Phase 21b): the export file type, so the Files sheet names it and the Restore
	     picker can ask for it. An encrypted archive; nothing else opens it on iOS. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.jsayram.niftyoutfitnook.backup</string>
			<key>UTTypeDescription</key>
			<string>Nifty Outfit Nook backup</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>nookbackup</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
