// Project-wide settings shared by Debug and Release. No secrets in any xcconfig.

SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
IPHONEOS_DEPLOYMENT_TARGET = 26.0
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO

// Swift 6 language mode with complete concurrency checking.
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete

// Warnings fail the build (decision 0001, item 5). NookKit sets the same in Package.swift.
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES

// Strings come from String Catalogs.
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
SWIFT_EMIT_LOC_STRINGS = YES

CODE_SIGN_STYLE = Automatic
ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES
ENABLE_STRICT_OBJC_MSGSEND = YES
ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES

// The real backend and sign-in (Phase 24a). Empty here, so the app runs on the fake sign-in and
// the in-process fake backend. Configs/Secrets.xcconfig (ignored by git) sets them when Jose
// switches to Clerk and Convex: see Secrets.xcconfig.example and docs/backend-switch.md. Neither
// is a secret (both ship inside the app), but they stay out of this public repo.
CLERK_PUBLISHABLE_KEY =
NOOK_API_BASE_URL =

// The website's support page (Phase 24d): what Help and Send feedback open, and the App Store's
// Support URL. A placeholder until the page is published (Phase 35b; compliance/SUPPORT_PAGE_OUTLINE.md
// in the planning repo). The app holds no email address, only this page. `$()` stops xcconfig
// reading `//` as a comment.
NOOK_SUPPORT_URL = https:/$()/niftyoutfitnook.pages.dev/support

// Live weather (Phase 29). NO keeps the stand-in weather and the app's signing as it is. YES turns on
// Apple WeatherKit and adds its entitlement (Configs/NiftyOutfit-WeatherKit.entitlements), which needs the
// WeatherKit capability on the App ID first: docs/weather.md has Jose's steps. Set it in
// Secrets.xcconfig on the Mac that builds, or here once the capability is confirmed.
NOOK_WEATHERKIT = NO

// Optional, ignored by git. Copy Signing.local.xcconfig.example to Signing.local.xcconfig
// and set DEVELOPMENT_TEAM there to build for a device. Secrets.xcconfig is reserved for
// non-secret identifiers that shouldn't be public; it never holds a real secret.
#include? "Signing.local.xcconfig"
#include? "Secrets.xcconfig"
