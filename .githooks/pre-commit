#!/usr/bin/env bash
# Blocks a commit if gitleaks finds a secret in the staged changes.
# Installed by scripts/install-hooks.sh. CI runs the same scan over the full history.
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks is not installed, so the commit was stopped." >&2
    echo "Install it with 'brew install gitleaks', then commit again." >&2
    exit 1
fi

if ! gitleaks git --pre-commit --staged --redact --no-banner --verbose; then
    echo >&2
    echo "pre-commit: gitleaks found what looks like a secret in the staged changes." >&2
    echo "Remove it and keep it out of the repo. If it was a real key, rotate it." >&2
    exit 1
fi
